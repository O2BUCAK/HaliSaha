rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupExists(groupId) {
      return groupId is string && exists(groupPath(groupId));
    }

    function isGroupAdmin(groupId) {
      return signedIn() && groupExists(groupId) && (
        request.auth.uid == get(groupPath(groupId)).data.createdBy ||
        (
          'admins' in get(groupPath(groupId)).data &&
          request.auth.uid in get(groupPath(groupId)).data.admins
        )
      );
    }

    function isGroupMember(groupId) {
      return signedIn() && groupExists(groupId) && (
        request.auth.uid == get(groupPath(groupId)).data.createdBy ||
        (
          'members' in get(groupPath(groupId)).data &&
          request.auth.uid in get(groupPath(groupId)).data.members
        )
      );
    }

    function ratingOnlyUpdate() {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings']) &&
        isGroupMember(resource.data.groupId) &&
        request.resource.data.ratings is map &&
        (
          !('playerIds' in resource.data) ||
          (
            resource.data.playerIds is list &&
            request.resource.data.ratings.keys().hasOnly(resource.data.playerIds)
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if signedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'id', 'createdAt', 'email']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // A shareable URL grants read-only viewing, not editing.
      allow get: if true;
      allow list: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.members is list &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.admins is list &&
        request.auth.uid in request.resource.data.admins;

      // Admins manage group settings/members/admins. A user may only add
      // themselves as a member without changing any other group data.
      allow update: if isGroupAdmin(groupId) || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        resource.data.members is list &&
        request.resource.data.members is list &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.auth.uid in request.resource.data.members
      );

      allow delete: if isGroupAdmin(groupId);
    }

    match /joinRequests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.groupId is string;
      allow get, list: if signedIn() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId)
      );
      allow update: if isGroupAdmin(resource.data.groupId);
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId)
      );
    }

    match /matches/{matchId} {
      // Shareable match URLs are public read-only views.
      allow get, list: if true;

      // Only group admins can create, edit teams/results, or delete matches.
      // Rating updates are the sole non-admin exception; they are restricted
      // to signed-in group members and cannot alter any other match field.
      allow create: if signedIn() &&
        request.resource.data.groupId is string &&
        isGroupAdmin(request.resource.data.groupId);

      allow update: if isGroupAdmin(resource.data.groupId) || ratingOnlyUpdate();
      allow delete: if isGroupAdmin(resource.data.groupId);
    }

    match /invitations/{invitationId} {
      allow get, list: if signedIn() && (
        request.auth.token.email == resource.data.email ||
        request.auth.uid == resource.data.invitedBy ||
        isGroupAdmin(resource.data.groupId)
      );
      allow create: if signedIn() &&
        request.resource.data.groupId is string &&
        isGroupAdmin(request.resource.data.groupId);
      allow update: if signedIn() && (
        request.auth.token.email == resource.data.email ||
        isGroupAdmin(resource.data.groupId)
      );
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.invitedBy ||
        request.auth.token.email == resource.data.email ||
        isGroupAdmin(resource.data.groupId)
      );
    }
  }
}