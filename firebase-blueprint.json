{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with display name, bio, and social links",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "User full name"
        },
        "nickname": {
          "type": "string",
          "maxLength": 50,
          "description": "User nickname on the pitch"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email"
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "User biography"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "System role"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Avatar URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "Group": {
      "title": "Group",
      "description": "Football group / league details",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "Group name"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Group description"
        },
        "code": {
          "type": "string",
          "maxLength": 20,
          "description": "Unique join code"
        },
        "createdBy": {
          "type": "string",
          "description": "Creator user UID"
        },
        "admins": {
          "type": "array",
          "description": "Array of admin user UIDs"
        },
        "members": {
          "type": "array",
          "description": "Array of member user UIDs"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "code", "createdBy", "members", "createdAt"]
    },
    "Match": {
      "title": "Match",
      "description": "Played football match record and stats",
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "description": "Associated group ID"
        },
        "date": {
          "type": "string",
          "description": "Match date"
        },
        "location": {
          "type": "string",
          "maxLength": 200,
          "description": "Pitch location"
        },
        "scoreA": {
          "type": "number",
          "description": "Team A score"
        },
        "scoreB": {
          "type": "number",
          "description": "Team B score"
        },
        "teamA": {
          "type": "array",
          "description": "Player IDs in Team A"
        },
        "teamB": {
          "type": "array",
          "description": "Player IDs in Team B"
        },
        "ratings": {
          "type": "object",
          "description": "Player ratings map"
        },
        "status": {
          "type": "string",
          "enum": ["planned", "completed", "cancelled"],
          "description": "Match status"
        },
        "createdBy": {
          "type": "string",
          "description": "Match creator UID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["groupId", "createdBy", "createdAt"]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "Request to join a group",
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "description": "Group ID"
        },
        "userId": {
          "type": "string",
          "description": "Requesting User ID"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected"],
          "description": "Request status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["groupId", "userId", "status", "createdAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Invitation to join a group",
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "description": "Group ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Invited email"
        },
        "invitedBy": {
          "type": "string",
          "description": "Inviter UID"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected"],
          "description": "Invitation status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["groupId", "email", "invitedBy", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Football league groups"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Match fixtures and results"
    },
    "/joinRequests/{requestId}": {
      "schema": "JoinRequest",
      "description": "Group join requests"
    },
    "/invitations/{invitationId}": {
      "schema": "Invitation",
      "description": "Direct group email invitations"
    }
  }
}
