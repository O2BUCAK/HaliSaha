rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupAdmin(groupId) {
      let groupDoc = get(/databases/$(database)/documents/groups/$(groupId));
      return isSignedIn() && groupDoc != null && (
        request.auth.uid == groupDoc.data.createdBy || 
        (groupDoc.data.keys().hasAll(['admins']) && request.auth.uid in groupDoc.data.admins)
      );
    }

    function isGroupMember(groupId) {
      let groupDoc = get(/databases/$(database)/documents/groups/$(groupId));
      return isSignedIn() && groupDoc != null && (
        request.auth.uid == groupDoc.data.createdBy ||
        (groupDoc.data.keys().hasAll(['members']) && request.auth.uid in groupDoc.data.members)
      );
    }

    // Users collection - Row-level security & field tampering protection
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // Block privilege escalation: cannot self-assign elevated role on create
      allow create: if isSignedIn() && request.auth.uid == userId &&
        (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == 'user');
      
      // Lock record access: users cannot tamper with role, id, or creation timestamp
      allow update: if isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id', 'createdAt']);
      
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    // Groups collection
    match /groups/{groupId} {
      // Allow public get for shareable group links
      allow get: if true;
      allow list: if isSignedIn();
      
      // Only authenticated users can create groups and must be the creator
      allow create: if isSignedIn() && 
                       request.auth.uid == request.resource.data.createdBy &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() <= 120;
      
      // Admins/creator can update group metadata, or members can safely join
      allow update: if isSignedIn() && (
        isGroupAdmin(groupId) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members
        )
      );
      
      // Only group creator can delete
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;
    }

    // Join Requests collection
    match /joinRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        isGroupAdmin(resource.data.groupId)
      );

      allow update: if isSignedIn() && isGroupAdmin(resource.data.groupId);
      
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        isGroupAdmin(resource.data.groupId)
      );
    }
    
    // Matches collection
    match /matches/{matchId} {
      allow get: if true;
      allow list: if true;
      
      // Only group admins can create matches
      allow create: if isSignedIn() && 
                       request.resource.data.groupId != null &&
                       isGroupAdmin(request.resource.data.groupId);
      
      // Admins can update all match fields. Signed-in members/players can update 'ratings'
      allow update: if isSignedIn() && (
        isGroupAdmin(resource.data.groupId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings'])
      );
      
      allow delete: if isSignedIn() && isGroupAdmin(resource.data.groupId);
    }
    
    // Invitations collection
    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        request.auth.token.email == resource.data.email || 
        request.auth.uid == resource.data.invitedBy
      );
      
      allow create: if isSignedIn() && isGroupAdmin(request.resource.data.groupId);
      
      allow update: if isSignedIn() && (
        request.auth.token.email == resource.data.email ||
        isGroupAdmin(resource.data.groupId)
      );
      
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.invitedBy || 
        request.auth.token.email == resource.data.email ||
        isGroupAdmin(resource.data.groupId)
      );
    }
  }
}
